[Unit]
Description=rPod UI application
# mpd: rpod exits if it can't reach MPD, and RestartSec=1 would burn through
# systemd's start limit before a slow-booting MPD is up. mpd.service is
# Type=notify, so After= waits until it's actually accepting connections.
After=rpod-wheel.service sound.target mpd.service
Wants=rpod-wheel.service mpd.service
# The boot logo: after it, so it can never draw over the UI, and the panel's
# framebuffer is there by then. Ordered only: sysinit.target pulls it in.
After=rpod-splash.service

[Service]
# Ready once its first frame is on the glass (src/app.c), so units ordered
# after rpod -- NetworkManager, system/boot/setup.sh -- wait for the UI.
Type=notify
TimeoutStartSec=30
ExecStart=/usr/local/bin/rpod
# Optional overrides (RPOD_FB, RPOD_MPD_SOCKET, RPOD_LISTENBRAINZ_TOKEN, ...)
# -- see src/main.c and src/platform/board_device.c.
EnvironmentFile=-/etc/rpod/env
StateDirectory=rpod
# The settings socket rpod-web talks to (src/ui/control.h).
RuntimeDirectory=rpod-ui
RuntimeDirectoryMode=0750
# Decoded cover art (src/ui/cover_cache.h): safe to delete, rebuilt as needed.
CacheDirectory=rpod
Restart=on-failure
RestartSec=1
User=rpod
Group=rpod
# i2c: the PiSugar's power chip, for the battery (src/power/battery.h).
SupplementaryGroups=video render input audio i2c

[Install]
WantedBy=multi-user.target
