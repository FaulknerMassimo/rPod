[Unit]
Description=rPod UI application
# mpd: rpod exits if it can't reach MPD, and RestartSec=1 would burn through
# systemd's start limit before a slow-booting MPD is up. mpd.service is
# Type=notify, so After= waits until it's actually accepting connections.
After=rpod-wheel.service sound.target mpd.service
Wants=rpod-wheel.service mpd.service

[Service]
ExecStart=/usr/local/bin/rpod
# Optional overrides (RPOD_FB, RPOD_MPD_SOCKET, RPOD_LISTENBRAINZ_TOKEN, ...)
# -- see src/main.c and src/platform/board_device.c.
EnvironmentFile=-/etc/rpod/env
StateDirectory=rpod
# Decoded cover art (src/ui/cover_cache.h): safe to delete, rebuilt as needed.
CacheDirectory=rpod
Restart=on-failure
RestartSec=1
User=rpod
Group=rpod
SupplementaryGroups=video render input audio

[Install]
WantedBy=multi-user.target
