[Unit]
Description=rPod web UI (uploads, library, settings)
# MPD for the library and playback; rpod for the settings it owns (its
# socket is looked up per request, so either can restart under this).
After=network.target mpd.service rpod.service
Wants=mpd.service

[Service]
ExecStart=/usr/local/bin/rpod-web
# The same overrides rpod reads, so the two agree on paths; plus
# RPOD_WEB_PORT, RPOD_WEB_PASSWORD, RPOD_WEB_HOSTS -- see web/rpod_web.c.
EnvironmentFile=-/etc/rpod/env
User=rpod
Group=rpod
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
# Uploads give way to playback and the UI.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
