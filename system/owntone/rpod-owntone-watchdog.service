# Restarts OwnTone when its player has stopped answering (docs/PLAN.md §6.3b).
#
# OwnTone 29.3 can deadlock when it restarts playback after a gap in its
# feed (src/input.c calls into the player holding the lock the player is
# waiting for). rpod stops it on a pause so that path isn't taken
# (src/audio/sinks.c), but a gap MPD makes itself -- its decoder stalling on
# the SD card -- still could. Deadlocked, it lists no speakers, so rpod has
# already given the sound back to the headset; this brings the speakers back.
# /api/outputs is answered by the player thread, which is what deadlocks.
# Two tries 5 s apart, so one landing while OwnTone is still starting (the
# port not open yet) doesn't count.
[Unit]
Description=Restart OwnTone if it has stopped answering
After=owntone.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
    systemctl -q is-active owntone.service || exit 0; \
    curl -s --max-time 10 -o /dev/null http://127.0.0.1:3689/api/outputs && exit 0; \
    sleep 5; \
    curl -s --max-time 10 -o /dev/null http://127.0.0.1:3689/api/outputs && exit 0; \
    echo "OwnTone stopped answering; restarting it"; \
    systemctl restart owntone.service'
